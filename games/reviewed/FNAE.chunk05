var loadingText = document.querySelector("#loading-text");

// Debug console
(function() {
  var dbg = document.createElement('div');
  dbg.id = 'dbg';
  dbg.style = 'position:fixed;top:0;left:0;width:320px;height:200px;display:flex;flex-direction:column;background:rgba(0,0,0,0.8);color:#0f0;font:11px monospace;padding:4px;z-index:99999;box-sizing:border-box;';
  var closeBtn = document.createElement('button');
  closeBtn.textContent = 'close';
  closeBtn.style = 'flex-shrink:0;display:block;width:100%;background:#222;color:#fff;border:1px solid #555;font:10px monospace;cursor:pointer;padding:2px 4px;margin-top:2px;';
  closeBtn.onclick = function(){ dbg.style.display='none'; };
  document.body.appendChild(dbg);
  window.dbgLog = function(msg) {
    var line = document.createElement('div');
    line.textContent = '[' + (performance.now()/1000).toFixed(2) + 's] ' + msg;
    (window._dbgInner || dbg).appendChild(line);
    var el = window._dbgInner || dbg;
    el.scrollTop = el.scrollHeight;
  };
  ['log','warn','error'].forEach(function(t) {
    var orig = console[t].bind(console);
    console[t] = function() {
      orig.apply(console, arguments);
      window.dbgLog((t === 'error' ? 'ERR: ' : t === 'warn' ? 'WRN: ' : '') + Array.from(arguments).join(' '));
    };
  });
  window.addEventListener('error', function(e) { window.dbgLog('ERR: ' + e.message + ' (' + e.filename + ':' + e.lineno + ')'); });
  window.addEventListener('unhandledrejection', function(e) { window.dbgLog('REJECT: ' + e.reason); });
  var dbgInner = document.createElement('div');
  dbgInner.style = 'flex:1;overflow-y:auto;';
  dbg.appendChild(dbgInner);
  dbg.appendChild(closeBtn);
  // redirect dbgLog to use inner
  window._dbgInner = dbgInner;
})();

(function() {
  dbgLog('Starting b64 decode...');
  const dataUrl = b64ToObjectURL(_DATA_B64, 'application/octet-stream');
  dbgLog('data decoded');
  const wasmUrl = b64ToObjectURL(_WASM_B64, 'application/wasm');
  dbgLog('wasm decoded');
  const webmUrl = b64ToObjectURL(_WEBM_B64, 'video/webm');
  dbgLog('webm decoded');

  window.randomwebm = webmUrl;
  const realSrc = Object.getOwnPropertyDescriptor(HTMLMediaElement.prototype, "src");
  Object.defineProperty(HTMLMediaElement.prototype, "src", {
    set(value) {
      if (typeof value === "string" && (value.includes("202512191935.mp4") || value.includes("202512191935.webm"))) {
        value = window.randomwebm;
      }
      return realSrc.set.call(this, value);
    },
    get() { return realSrc.get.call(this); }
  });

  // FPS counter
  var fps = document.createElement('div');
  fps.style = 'position:fixed;top:0;right:0;background:rgba(0,0,0,0.7);color:#fff;font:11px monospace;padding:2px 6px;z-index:99999;pointer-events:none;';
  fps.textContent = 'FPS: --';
  document.body.appendChild(fps);
  var fpsFrames=0, fpsLast=performance.now();
  function fpsCount(){ fpsFrames++; var now=performance.now(); if(now-fpsLast>=500){ fps.textContent='FPS: '+Math.round(fpsFrames*1000/(now-fpsLast)); fpsFrames=0; fpsLast=now; } requestAnimationFrame(fpsCount); }
  requestAnimationFrame(fpsCount);

  var canvas = document.querySelector("#unity-canvas");
  var loadingBar = document.querySelector("#unity-loading-bar");
  var progressBarFull = document.querySelector("#unity-progress-bar-full");

  var config = {
    arguments: [],
    dataUrl: dataUrl,
    frameworkUrl: URL.createObjectURL(new Blob([_FRAMEWORK_JS], {type: 'application/javascript'})),
    codeUrl: wasmUrl,
    streamingAssetsUrl: 'StreamingAssets',
    companyName: 'DefaultCompany',
    productName: 'fnae',
    productVersion: '1.0',
    showBanner: function(msg, type) { dbgLog('Banner: ' + msg); },
  };

  if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
    var meta = document.createElement('meta');
    meta.name = 'viewport';
    meta.content = 'width=device-width, height=device-height, initial-scale=1.0, user-scalable=no, shrink-to-fit=yes';
    document.getElementsByTagName('head')[0].appendChild(meta);
  }


// Intercept fetch for StreamingAssets
const _STREAMING_FILES = {
  'UnityServicesProjectConfiguration.json': '{"Keys":["com.unity.services.core.environment-name","com.unity.services.core.cloud-environment","com.unity.services.core.version","com.unity.services.core.initializer-assembly-qualified-names","com.unity.services.core.all-package-names"],"Values":[{"m_Value":"production","m_IsReadOnly":false},{"m_Value":"production","m_IsReadOnly":false},{"m_Value":"1.16.0","m_IsReadOnly":true},{"m_Value":"Unity.Services.Core.Registration.CorePackageInitializer, Unity.Services.Core.Registration, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;Unity.Services.Core.Internal.IInitializablePackageV2, Unity.Services.Core.Internal, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;Unity.Services.Core.Editor.StatusInitializer, Unity.Services.Core.Editor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null","m_IsReadOnly":true},{"m_Value":"com.unity.services.core","m_IsReadOnly":false}]}'
};

const _origFetch = window.fetch.bind(window);
window.fetch = function(url, opts) {
  const urlStr = typeof url === 'string' ? url : (url && url.url) || String(url);
  dbgLog('fetch: ' + urlStr.split('/').pop());
  if (typeof url === 'string') {
    for (const [filename, data] of Object.entries(_STREAMING_FILES)) {
      if (url.includes(filename)) {
        dbgLog('Served: ' + filename);
        const blob = new Blob([data], {type: 'application/json'});
        return Promise.resolve(new Response(blob, {status: 200, headers: {'Content-Type': 'application/json'}}));
      }
    }
  }
  return _origFetch(url, opts).then(r => { dbgLog('fetch OK ' + r.status + ': ' + urlStr.split('/').pop()); return r; })
    .catch(e => { dbgLog('fetch FAIL: ' + urlStr.split('/').pop() + ' ' + e); throw e; });
};

  loadingBar.style.display = "block";
  dbgLog('Calling createUnityInstance...');

  createUnityInstance(canvas, config, (progress) => {
    progressBarFull.style.width = 100 * progress + "%";
    if (Math.round(progress * 20) % 4 === 0) dbgLog('Progress: ' + Math.round(progress * 100) + '%');
  }).then((unityInstance) => {
    dbgLog('Unity loaded OK');
    loadingBar.style.display = "none";
    loadingText.remove();
  }).catch((message) => {
    dbgLog('ERR: ' + message);
    console.error("Unity error:", message);
  });
})();
    </script>
  </body>
</html>